  {
   "id": "e7",
   "type": "text",
   "x": 100,
   "y": 170,
   "width": 800,
   "height": 39.0,
   "text": "3. RULES: branch protections + required checks apply. An incompatible rule (e.g. allowed commit\n   authors) BLOCKS the agent. Ruleset fix: add Copilot as a bypass actor (not for branch protection)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#e67700",
   "originalText": "3. RULES: branch protections + required checks apply. An incompatible rule (e.g. allowed commit\n   authors) BLOCKS the agent. Ruleset fix: add Copilot as a bypass actor (not for branch protection)"
  },
