   "height": 19.5,
   "text": "1. REPO: fixed when the task starts. One repo per run; other repos = context only (via MCP settings)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#2b8a3e",
   "originalText": "1. REPO: fixed when the task starts. One repo per run; other repos = context only (via MCP settings)"
