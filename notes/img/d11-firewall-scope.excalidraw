  {
   "id": "e18",
   "type": "text",
   "x": 20,
   "y": 330,
   "width": 900,
   "height": 54.599999999999994,
   "text": "Blocked -> warning in the PR body (new PR) or a PR comment (existing PR): blocked address + command.\nCustom allowlist: domain = domain + subdomains \u00b7 URL = that scheme + host + path prefix only.\nOrg: firewall / recommended list = Enabled \u00b7 Disabled \u00b7 Let repositories decide (default); repo custom rules allowed by default.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#495057",
   "originalText": "Blocked -> warning in the PR body (new PR) or a PR comment (existing PR): blocked address + command.\nCustom allowlist: domain = domain + subdomains \u00b7 URL = that scheme + host + path prefix only.\nOrg: firewall / recommended list = Enabled \u00b7 Disabled \u00b7 Let repositories decide (default); repo custom rules allowed by default."
  }
